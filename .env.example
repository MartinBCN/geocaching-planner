# Copy to .env (done by `mise run setup`). Never commit real secrets.
# Sections are added by the tickets that own them.

# --- Backend (T-002) ---
# Bind address and port for `mise run dev` and `python -m geocaching_planner`.
GCP_HOST=127.0.0.1
GCP_PORT=8000
# Set to true for JSON log lines (console output otherwise).
GCP_LOG_JSON=false
# Default map tile URL (overridable in Settings).
GCP_TILE_URL=https://{s}.tile-cyclosm.openstreetmap.fr/cyclosm/{z}/{x}/{y}.png
# Database URL, used from T-003 onward.
GCP_DATABASE_URL=postgresql+asyncpg://geocaching:geocaching@127.0.0.1:5432/geocaching
# --- Database (T-003) ---
# Host port published on 127.0.0.1 for the compose db service. Change if 5432 is taken.
DB_PORT=5432
# Credentials for the local compose db service (dev only).
POSTGRES_USER=geocaching
POSTGRES_PASSWORD=geocaching
POSTGRES_DB=geocaching
# --- BRouter (T-023) ---
# Host port published on 127.0.0.1 for the compose brouter service.
BROUTER_PORT=17777
# Comma-separated segment tiles for `mise run brouter:segments` (default E0_N50,E5_N50).
# BROUTER_SEGMENTS=E0_N50,E5_N50
# --- Frontend (T-004) ---
# Backend origin the Vite dev server proxies /api to (loopback only, ADR-0002).
VITE_API_TARGET=http://127.0.0.1:8000
