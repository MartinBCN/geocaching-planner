# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# Node / frontend
node_modules/
dist/
frontend/playwright-report/
frontend/test-results/
frontend/coverage/

# IDE / OS
.idea/
.vscode/
.DS_Store

# Environment
.env
.env.*
!.env.example

# BRouter routing data (downloaded via `mise run brouter:segments`)
infra/brouter/segments/*
!infra/brouter/segments/.gitkeep
# Host-side download cache for the pinned BRouter release ZIP (see infra/brouter/fetch-release.sh)
infra/brouter/.cache/

# Pocket Query data is personal; test fixtures are the only exception
*.gpx
*.zip
!backend/tests/fixtures/**/*.gpx
!backend/tests/fixtures/**/*.zip

# Drafts are personal and never tracked
docs/drafts/*
!docs/drafts/.gitkeep
